# Personal Hub — Environment Configuration
# Copy this file to .env and fill in your values.

# Django settings
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed origins for CSRF validation.
# For HTTPS domains include the scheme: https://yourdomain.com
# For local development the defaults work.
#DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL database
# For a local database, keep DB_HOST=localhost.
# For a remote PostgreSQL server, set DB_HOST to the server's IP or hostname
# (e.g. DB_HOST=192.168.1.100 or DB_HOST=db.example.com).
# If the remote server requires SSL, uncomment DB_SSLMODE=require.
# For other SSL modes: disable, allow, prefer, require, verify-ca, verify-full.
DB_NAME=personal_hub
DB_USER=personal_hub
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432
#DB_SSLMODE=require
ADMIN=admin
ADMIN_PASSWORD=admin_password